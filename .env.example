# Database
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
USE_DATABASE=true

# Protect manual refresh and Vercel Cron calls.
# Vercel recommends setting CRON_SECRET for protected cron endpoints.
CRON_SECRET=replace-with-a-long-random-secret
REFRESH_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Discovery/search provider. Configure at least one.
# SerpApi is the simplest Google-results adapter:
SERPAPI_API_KEY=

# Or Brave Search:
BRAVE_SEARCH_API_KEY=

# Or Bing Web Search:
BING_SEARCH_API_KEY=

# Discovery behavior
AUTO_IMPORT_DISCOVERED=true
DISCOVERY_RESULTS_PER_QUERY=8
DISCOVERY_MAX_QUERIES=12

# Optional JSON array of custom queries:
# [{"areaId":13,"query":"hotel for sale Highlands Scotland freehold"},{"areaId":14,"query":"guest house for sale Argyll Bute"}]
SCRAPER_QUERIES_JSON=
